<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="Font.Sans">Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Serif">Georgia, 思源宋体</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="Font.Size.Caption">10</sys:Double>
  <sys:Double x:Key="Font.Size.Small">11</sys:Double>
  <sys:Double x:Key="Font.Size.Body">13</sys:Double>
  <sys:Double x:Key="Font.Size.Subtitle">15</sys:Double>
  <sys:Double x:Key="Font.Size.Title">18</sys:Double>
  <sys:Double x:Key="Font.Size.PageTitle">24</sys:Double>
  <sys:Double x:Key="Font.Size.Display">52</sys:Double>
  <sys:Double x:Key="Font.Size.Hero">88</sys:Double>
</ResourceDictionary>
