<Window x:Class="PipelineControl.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="中央净软线控制台"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="420"
        Background="{StaticResource Bg.PageBrush}"
        FontFamily="{StaticResource Font.Sans}"
        mc:Ignorable="d">
  <Grid>
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{StaticResource Text.PrimaryBrush}"
                 FontSize="{StaticResource Font.Size.PageTitle}"
                 FontWeight="SemiBold"
                 Text="{Binding ReadyText}" />
      <Button Width="160"
              Height="38"
              Margin="0,24,0,0"
              Command="{Binding ShowVersionInfoCommand}"
              Content="显示版本信息" />
    </StackPanel>
  </Grid>
</Window>
