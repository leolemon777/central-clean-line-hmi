<UserControl x:Class="PipelineControl.UI.Views.Pages.Servo.ServoPage"
             FontFamily="{StaticResource Font.Chinese}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PipelineControl.UI.ViewModels.Pages.Servo.Models"
             xmlns:motion="clr-namespace:PipelineControl.UI.Views.Common.Behaviors">
    <UserControl.Resources>
        <!-- 通用面板：暖色卡片 -->
        <Style x:Key="PanelStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Bg.Card.Brush}" />
        </Style>

        <!-- 左侧轴列表项：选中态高亮整行 -->
        <Style x:Key="AxisRowStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Bg.Surface.Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
                    <Setter Property="Background" Value="{DynamicResource Brand.SelectedBg.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 大号方向按钮：轻度拟物，圆角+按下凹陷 -->
        <Style x:Key="BigButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="motion:InteractionMotionBehavior.IsMotionEnabled" Value="True" />
            <Setter Property="motion:InteractionMotionBehavior.PressScale" Value="0.94" />
            <Setter Property="motion:InteractionMotionBehavior.ShadowLevel" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Style="{StaticResource ButtonTemplateContentPresenterStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部小工具按钮 -->
        <Style x:Key="ToolButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{DynamicResource Bg.Card.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="motion:InteractionMotionBehavior.IsMotionEnabled" Value="True" />
            <Setter Property="motion:InteractionMotionBehavior.PressScale" Value="0.96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Style="{StaticResource ButtonTemplateContentPresenterStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover.Brush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brand.Primary.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
        </Style>

        <Style x:Key="DangerToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Status.Danger.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger.Brush}" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Page.Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource Bg.Card.Brush}"
                BorderBrush="{DynamicResource Border.Default.Brush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：标题 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="伺服控制台"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Accent.Brush}" />
                    <TextBlock Text="禾川 SV-X4EA · Modbus TCP"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary.Brush}" />
                </StackPanel>

                <!-- 手动/点动/单轴模式开关 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="20,0,0,0">
                    <Button Content="{Binding ManualModeText}"
                            Command="{Binding ToggleAutoModeCommand}"
                            Style="{StaticResource PrimaryToolButtonStyle}"
                            MinWidth="92"
                            PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                            PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                            ToolTip="切换手动/自动模式" />
                    <Button Content="{Binding JogModeText}"
                            Command="{Binding ToggleJogModeCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            MinWidth="92"
                            PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                            PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                            ToolTip="点动模式下按住转，松开停；连续模式下点击转，需手动停止" />
                    <Button Content="{Binding SyncAllText}"
                            Command="{Binding ToggleSyncAllCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            MinWidth="92"
                            PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                            PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                            ToolTip="切换单轴/四轴同步操作" />
                </StackPanel>

                <!-- 连接状态徽章：绿/红色块 + 白字，醒目 -->
                <Border Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center"
                        CornerRadius="6" Padding="14,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Status.Danger.Brush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Status.Running.Brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Text.White.Brush}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.White.Brush}"
                                   Text="{Binding ConnectionStatusText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 中：网关 + 操作提示（灰色辅助信息） -->
                <StackPanel Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Text.Tertiary.Brush}">
                        <Run Text="网关 " />
                        <Run Text="{Binding GatewayText, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text.Secondary.Brush}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary.Brush}"
                               Text="{Binding StatusText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360" />
                </StackPanel>

                <!-- 右：连接 + 急停 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="连接"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ToolButtonStyle}"
                            PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                            PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                    <Button Content="急停全部"
                            Command="{Binding EmergencyStopCommand}"
                            Style="{StaticResource DangerToolButtonStyle}"
                            PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                            PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左轴列表 + 右大仪表 -->
        <Grid Grid.Row="2" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：4 轴列表 -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="轴列表"
                               Margin="6,4,6,8"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.Tertiary.Brush}" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ServoAxisViewModel}">
                                <Border Style="{StaticResource AxisRowStyle}"
                                        PreviewMouseLeftButtonDown="AxisRow_OnMouseLeftButtonDown"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 状态灯 -->
                                        <Ellipse Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Status.Neutral.Brush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Status.Danger.Brush}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsForward}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Status.Running.Brush}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsReverse}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Status.Running.Brush}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsEnabled}" Value="True" />
                                                                <Condition Binding="{Binding IsStopped}" Value="True" />
                                                                <Condition Binding="{Binding HasFault}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Status.Warning.Brush}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text.Primary.Brush}" />
                                            <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12"
                                                       Foreground="{DynamicResource Text.Tertiary.Brush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brand.Primary.Brush}">
                                            <Run Text="{Binding ActualRpm, Mode=OneWay}" />
                                            <Run Text="rpm" FontSize="11" FontWeight="Normal"
                                                 Foreground="{DynamicResource Text.Tertiary.Brush}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 右：选中轴大仪表盘 -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid DataContext="{Binding SelectedAxis}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 轴名 + 故障 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary.Brush}" />
                            <TextBlock Margin="0,4,0,0" FontSize="14"
                                       Foreground="{DynamicResource Text.Tertiary.Brush}">
                                <Run Text="站号 " />
                                <Run Text="{Binding Station, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DirectionText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Status.Danger.Brush}"
                                   Text="{Binding FaultText, Mode=OneWay}" />
                    </Grid>

                    <!-- 中央大数字转速 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="实际转速" FontSize="14"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.Tertiary.Brush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                            <TextBlock Text="{Binding ActualRpm, Mode=OneWay}"
                                       FontSize="96" FontWeight="Bold"
                                       Foreground="{DynamicResource Brand.Primary.Brush}" />
                            <TextBlock Text="rpm" FontSize="22" FontWeight="Bold"
                                       VerticalAlignment="Bottom" Margin="8,0,0,16"
                                       Foreground="{DynamicResource Text.Tertiary.Brush}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontSize="14" Margin="0,4,0,0">
                            <Run Text="目标 " Foreground="{DynamicResource Text.Tertiary.Brush}" />
                            <Run Text="{Binding TargetRpm, Mode=OneWay}" FontWeight="Bold"
                                 Foreground="{DynamicResource Text.Primary.Brush}" />
                            <Run Text=" rpm" Foreground="{DynamicResource Text.Tertiary.Brush}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- 转速输入 -->
                    <StackPanel Grid.Row="2" Margin="0,12" HorizontalAlignment="Center">
                        <TextBlock Text="转速设定 (rpm，正数，方向由下方按钮决定)"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary.Brush}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="-10"
                                    Command="{Binding DataContext.DecreaseSpeedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Style="{StaticResource ToolButtonStyle}"
                                    MinWidth="88"
                                    PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                    PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding SpeedInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200"
                                     FontSize="22" FontWeight="Bold"
                                     Padding="10,8"
                                     HorizontalContentAlignment="Center"
                                     IsEnabled="{Binding CanToggle}" />
                            <Button Grid.Column="4"
                                    Content="+10"
                                    Command="{Binding DataContext.IncreaseSpeedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Style="{StaticResource ToolButtonStyle}"
                                    MinWidth="88"
                                    PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                    PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                            <Button Grid.Column="6"
                                    Content="写入"
                                    Command="{Binding DataContext.ApplySpeedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    MinWidth="104"
                                    PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                    PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                        </Grid>
                    </StackPanel>

                    <!-- 三向大按钮 + 使能/复位 -->
                    <Grid Grid.Row="3" Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="◀ 反转"
                                Command="{Binding DataContext.ReverseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Style="{StaticResource BigButtonStyle}"
                                Background="{DynamicResource Status.Warning.Brush}"
                                Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                                IsEnabled="{Binding CanToggle}"
                                PreviewMouseLeftButtonDown="JogButton_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="JogButton_OnPreviewMouseLeftButtonUp"
                                LostMouseCapture="JogButton_OnLostMouseCapture"
                                PreviewTouchDown="JogButton_OnPreviewTouchDown"
                                PreviewTouchUp="JogButton_OnPreviewTouchUp"
                                LostTouchCapture="JogButton_OnLostTouchCapture"
                                PreviewStylusDown="JogButton_OnPreviewStylusDown"
                                PreviewStylusUp="JogButton_OnPreviewStylusUp"
                                LostStylusCapture="JogButton_OnLostStylusCapture" />
                        <Button Grid.Column="1" Content="■ 停止"
                                Command="{Binding DataContext.StopAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Style="{StaticResource BigButtonStyle}"
                                Background="{DynamicResource Text.Tertiary.Brush}"
                                Foreground="{DynamicResource Text.White.Brush}"
                                IsEnabled="{Binding CanToggle}"
                                PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                        <Button Grid.Column="2" Content="▶ 正转"
                                Command="{Binding DataContext.ForwardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Style="{StaticResource BigButtonStyle}"
                                Background="{DynamicResource Status.Running.Brush}"
                                Foreground="{DynamicResource Brand.OnPrimary.Brush}"
                                IsEnabled="{Binding CanToggle}"
                                PreviewMouseLeftButtonDown="JogButton_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="JogButton_OnPreviewMouseLeftButtonUp"
                                LostMouseCapture="JogButton_OnLostMouseCapture"
                                PreviewTouchDown="JogButton_OnPreviewTouchDown"
                                PreviewTouchUp="JogButton_OnPreviewTouchUp"
                                LostTouchCapture="JogButton_OnLostTouchCapture"
                                PreviewStylusDown="JogButton_OnPreviewStylusDown"
                                PreviewStylusUp="JogButton_OnPreviewStylusUp"
                                LostStylusCapture="JogButton_OnLostStylusCapture" />
                        <Button Grid.Column="3"
                                Command="{Binding DataContext.ServoOffCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BigButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Content" Value="○ 停用" />
                                            <Setter Property="Background" Value="{DynamicResource Status.Warning.Brush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            使能
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding DataContext.ServoOnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BigButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Content" Value="● 使能" />
                                    <Setter Property="Background" Value="{DynamicResource Brand.Primary.Brush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="4" Content="复位"
                                Command="{Binding DataContext.ResetFaultCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding DataContext.SelectedAxis, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                Style="{StaticResource BigButtonStyle}"
                                Background="{DynamicResource Bg.Surface.Brush}"
                                Foreground="{DynamicResource Text.Secondary.Brush}"
                                PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                PreviewStylusUp="CommandButton_OnPreviewStylusUp" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
