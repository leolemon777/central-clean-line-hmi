<UserControl x:Class="PipelineControl.UI.Views.Pages.IoMonitor.OutputTestPage"
             FontFamily="{StaticResource Font.Chinese}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PipelineControl.UI.Views.Pages.IoMonitor.Controls"
             xmlns:motion="clr-namespace:PipelineControl.UI.Views.Common.Behaviors"
             xmlns:models="clr-namespace:PipelineControl.UI.ViewModels.Pages.IoMonitor.Models">
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Bg.Card}" Offset="0" />
                        <GradientStop Color="{DynamicResource Bg.Surface}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Bg.Card.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="motion:InteractionMotionBehavior.IsMotionEnabled" Value="True" />
            <Setter Property="motion:InteractionMotionBehavior.HoverLift" Value="1" />
            <Setter Property="motion:InteractionMotionBehavior.PressScale" Value="0.982" />
            <Setter Property="motion:InteractionMotionBehavior.ShadowLevel" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Style="{StaticResource ButtonTemplateContentPresenterStyle}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Bg.Hover.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brand.Accent.Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brand.Accent.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryIoButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IoButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brand.Primary.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
        </Style>

        <Style x:Key="ManualModeToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Bg.Card.Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="motion:InteractionMotionBehavior.IsMotionEnabled" Value="True" />
            <Setter Property="motion:InteractionMotionBehavior.HoverLift" Value="1" />
            <Setter Property="motion:InteractionMotionBehavior.PressScale" Value="0.982" />
            <Setter Property="motion:InteractionMotionBehavior.ShadowLevel" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Style="{StaticResource ButtonTemplateContentPresenterStyle}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Bg.Hover.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brand.Accent.Brush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="手动 ON" />
                                <Setter Property="Background" Value="{DynamicResource Brand.Primary.Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brand.Accent.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionIoButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IoButtonStyle}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brand.Primary.Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brand.OnPrimary.Brush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brand.Primary.Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.CardTitle}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
        </Style>

        <DataTemplate x:Key="InputIoModuleTemplate" DataType="{x:Type models:IoModuleViewModel}">
            <controls:IoBitGridView ModuleLabel="{Binding ModuleLabel}"
                                    RegisterValueHex="{Binding RegisterValueHex}"
                                    Columns="{Binding Columns}"
                                    CellWidth="{Binding CellWidth}"
                                    CellHeight="{Binding CellHeight}"
                                    Points="{Binding Points}"
                                    IsOutput="{Binding IsOutput}" />
        </DataTemplate>

        <DataTemplate x:Key="OutputIoModuleTemplate" DataType="{x:Type models:IoModuleViewModel}">
            <controls:IoBitGridView ModuleLabel="{Binding ModuleLabel}"
                                    RegisterValueHex="{Binding RegisterValueHex}"
                                    Columns="{Binding Columns}"
                                    CellWidth="{Binding CellWidth}"
                                    CellHeight="{Binding CellHeight}"
                                    Points="{Binding Points}"
                                    IsOutput="{Binding IsOutput}"
                                    SelectionChangedCommand="{Binding DataContext.SelectOutputPointCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Page.Brush}">
        <Border Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Border.Default.Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="IO 点位"
                                       FontSize="{StaticResource Font.Size.Small}"
                                       Foreground="{DynamicResource Text.Accent.Brush}" />
                            <TextBlock Text="输入 / 输出"
                                       Margin="0,3,0,0"
                                       FontSize="{StaticResource Font.Size.PageTitle}"
                                       Foreground="{DynamicResource Text.Primary.Brush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <ToggleButton Content="手动 OFF"
                                          IsChecked="{Binding IsManualMode, Mode=TwoWay}"
                                          Style="{StaticResource ManualModeToggleStyle}"
                                          PreviewTouchDown="CommandButton_OnPreviewTouchDown"
                                          PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                          PreviewStylusDown="CommandButton_OnPreviewStylusDown"
                                          PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                                          Margin="0,0,8,0" />
                            <Button Content="连接"
                                    Command="{Binding ConnectCommand}"
                                    Style="{StaticResource PrimaryIoButtonStyle}"
                                    PreviewTouchDown="CommandButton_OnPreviewTouchDown"
                                    PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                    PreviewStylusDown="CommandButton_OnPreviewStylusDown"
                                    PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                                    Margin="0,0,8,0" />
                            <Button Content="全部复位"
                                    Command="{Binding ResetAllOutputsCommand}"
                                    PreviewTouchDown="CommandButton_OnPreviewTouchDown"
                                    PreviewTouchUp="CommandButton_OnPreviewTouchUp"
                                    PreviewStylusDown="CommandButton_OnPreviewStylusDown"
                                    PreviewStylusUp="CommandButton_OnPreviewStylusUp"
                                    Style="{StaticResource IoButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="{StaticResource Font.Size.Body}"
                                   Foreground="{DynamicResource Text.Primary.Brush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="1"
                                   Margin="20,0,0,0"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   VerticalAlignment="Center">
                            <Run Text="X ON " />
                            <Run Text="{Binding InputOnCount, Mode=OneWay}" />
                            <Run Text=" · OFF " />
                            <Run Text="{Binding InputOffCount, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Column="2"
                                   Margin="20,0,0,0"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{DynamicResource Text.Secondary.Brush}"
                                   VerticalAlignment="Center">
                            <Run Text="Y ON " />
                            <Run Text="{Binding OutputOnCount, Mode=OneWay}" />
                            <Run Text=" · OFF " />
                            <Run Text="{Binding OutputOffCount, Mode=OneWay}" />
                            <Run Text=" · 手动 " />
                            <Run Text="{Binding ManualOperationCount, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Column="3"
                                   Margin="20,0,0,0"
                                   Text="{Binding SelectedPointText, Mode=OneWay}"
                                   FontSize="{StaticResource Font.Size.Small}"
                                   Foreground="{DynamicResource Text.Tertiary.Brush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="1.15*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="5,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="X 输入"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Content="{Binding InputModules[0]}"
                                                ContentTemplate="{StaticResource InputIoModuleTemplate}" />
                                
                                <ContentControl Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Content="{Binding InputModules[1]}"
                                                ContentTemplate="{StaticResource InputIoModuleTemplate}" />

                                <ContentControl Grid.Column="2"
                                                Content="{Binding InputModules[2]}"
                                                ContentTemplate="{StaticResource InputIoModuleTemplate}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="5,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="点动输出"
                                       Style="{StaticResource SectionTitleStyle}" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding OutputActionGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="{x:Type ContentPresenter}">
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OutputActionGroupViewModel}">
                                        <Button Style="{StaticResource ActionIoButtonStyle}"
                                                PreviewMouseLeftButtonDown="ActionButton_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="ActionButton_OnPreviewMouseLeftButtonUp"
                                                LostMouseCapture="ActionButton_OnLostMouseCapture"
                                                PreviewTouchDown="ActionButton_OnPreviewTouchDown"
                                                PreviewTouchUp="ActionButton_OnPreviewTouchUp"
                                                LostTouchCapture="ActionButton_OnLostTouchCapture"
                                                PreviewStylusDown="ActionButton_OnPreviewStylusDown"
                                                PreviewStylusUp="ActionButton_OnPreviewStylusUp"
                                                LostStylusCapture="ActionButton_OnLostStylusCapture"
                                                ToolTip="按住输出，松开断开">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextAlignment="Center"
                                                           FontSize="{StaticResource Font.Size.Small}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PointText}"
                                                           Margin="0,1,0,0"
                                                           TextAlignment="Center"
                                                           FontSize="{StaticResource Font.Size.Micro}"
                                                           Opacity="0.8" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="4" ItemsSource="{Binding OutputModules}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="{x:Type ContentPresenter}">
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="OutputIoModuleTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
