<UserControl x:Class="PipelineControl.UI.Views.Shell.Components.TopNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Chinese}"
             Height="48">
    <Border Background="{DynamicResource Bg.Surface.Brush}"
            BorderBrush="{DynamicResource Border.Default.Brush}"
            BorderThickness="0,0,0,1"
            Padding="20,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <Border Width="36"
                        Height="36"
                        CornerRadius="8"
                        SnapsToDevicePixels="True"
                        Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#263238" Offset="0" />
                            <GradientStop Color="#C65B38" Offset="0.58" />
                            <GradientStop Color="#E8A04A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Viewbox Width="26"
                             Height="26"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stretch="Uniform">
                        <Canvas Width="32" Height="32">
                            <Path Data="M16,2.8 L28.2,9.8 L28.2,22.2 L16,29.2 L3.8,22.2 L3.8,9.8 Z"
                                  Stroke="#FFF7EE"
                                  StrokeThickness="1.9"
                                  StrokeLineJoin="Round"
                                  Fill="#24FFFFFF" />
                            <Path Data="M10.2,10.5 L16,7.2 L21.8,10.5 L21.8,17.2 L16,20.6 L10.2,17.2 Z"
                                  Stroke="#FFF7EE"
                                  StrokeThickness="1.65"
                                  StrokeLineJoin="Round"
                                  Fill="#44FFFFFF" />
                            <Path Data="M16,20.6 L16,27.1 M21.8,17.2 L27.5,20.5 M10.2,17.2 L4.5,20.5 M16,7.2 L16,3.9"
                                  Stroke="#FFF7EE"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.86" />
                            <Ellipse Canvas.Left="13.6"
                                     Canvas.Top="13.6"
                                     Width="4.8"
                                     Height="4.8"
                                     Fill="#FFF7EE" />
                            <Ellipse Canvas.Left="14.3"
                                     Canvas.Top="1.4"
                                     Width="3.4"
                                     Height="3.4"
                                     Fill="#FFF7EE" />
                            <Ellipse Canvas.Left="26.5"
                                     Canvas.Top="19"
                                     Width="3.4"
                                     Height="3.4"
                                     Fill="#FFF7EE" />
                            <Ellipse Canvas.Left="2.1"
                                     Canvas.Top="19"
                                     Width="3.4"
                                     Height="3.4"
                                     Fill="#FFF7EE" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="净水工厂智造"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Chinese}"
                           FontSize="{StaticResource Font.Size.CardTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary.Brush}"
                           TextTrimming="CharacterEllipsis"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="ClearType" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="中央净软线控制台"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Chinese}"
                       FontSize="{StaticResource Font.Size.DetailTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary.Brush}"
                       TextOptions.TextFormattingMode="Ideal"
                       TextOptions.TextRenderingMode="ClearType" />

            <Button Grid.Column="2"
                    Content="{Binding ThemeToggleText}"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip="{Binding ThemeToggleTooltip}"
                    Width="86"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="12,4"
                    FontSize="{StaticResource Font.Size.Small}"
                    Foreground="{DynamicResource Text.Secondary.Brush}"
                    Background="{DynamicResource Bg.Card.Brush}"
                    BorderBrush="{DynamicResource Border.Default.Brush}"
                    BorderThickness="1" />

            <Border Grid.ColumnSpan="3"
                    Height="1"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#66D85A30" Offset="0.32" />
                        <GradientStop Color="#99B55335" Offset="0.5" />
                        <GradientStop Color="#66D85A30" Offset="0.68" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</UserControl>




