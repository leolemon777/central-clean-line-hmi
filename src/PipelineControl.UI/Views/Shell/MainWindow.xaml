<Window x:Class="PipelineControl.UI.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:PipelineControl.UI.Views.Shell.Components"
        xmlns:motion="clr-namespace:PipelineControl.UI.Views.Common.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="中央净软线控制台"
        Icon="pack://application:,,,/PipelineControl.UI;component/Assets/AppIcon.ico"
        Width="1360"
        Height="760"
        MinWidth="1200"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg.Page.Brush}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Bg.Surface.Brush}"
                BorderBrush="{DynamicResource Border.Subtle.Brush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Image Width="20"
                           Height="20"
                           Source="pack://application:,,,/PipelineControl.UI;component/Assets/AppIcon.ico"
                           Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="净水工厂智造 · 中央净软线控制台"
                               FontFamily="{StaticResource Font.Chinese}"
                               FontSize="{StaticResource Font.Size.Meta}"
                               FontWeight="Normal"
                               Foreground="{DynamicResource Text.Primary.Brush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="−"
                            Width="46"
                            Height="33"
                            Padding="0"
                            FontSize="{StaticResource Font.Size.Title}"
                            Foreground="{DynamicResource Text.Secondary.Brush}"
                            Background="{DynamicResource Bg.Transparent.Brush}"
                            BorderThickness="0"
                            Click="MinimizeButton_OnClick" />
                    <Button Content="□"
                            Width="46"
                            Height="33"
                            Padding="0"
                            FontSize="{StaticResource Font.Size.Body}"
                            Foreground="{DynamicResource Text.Secondary.Brush}"
                            Background="{DynamicResource Bg.Transparent.Brush}"
                            BorderThickness="0"
                            Click="MaximizeButton_OnClick" />
                    <Button Content="×"
                            Width="46"
                            Height="33"
                            Padding="0"
                            FontSize="{StaticResource Font.Size.Title}"
                            Foreground="{DynamicResource Text.Secondary.Brush}"
                            Background="{DynamicResource Bg.Transparent.Brush}"
                            BorderThickness="0"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <components:TopNavBar Grid.Row="1" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <components:SideNav Grid.Column="0" />

            <Border Grid.Column="1"
                    Background="{DynamicResource Bg.Page.Brush}"
                    Padding="12,8">
                <ContentControl Content="{Binding CurrentPageView}"
                                motion:InteractionMotionBehavior.IsPageTransitionEnabled="True"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>

        <components:StatusBar Grid.Row="3"
                              DataContext="{Binding StatusBar}" />
    </Grid>
</Window>




