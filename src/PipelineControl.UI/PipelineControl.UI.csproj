<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PipelineControl.UI</AssemblyName>
    <RootNamespace>PipelineControl.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0+local-build</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="2025.11.13" />
    <AssemblyMetadata Include="GitHash" Value="local-build" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="NModbus" Version="3.0.83" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\io-points.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\servo-registers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\C#例程源代码及库文件\动态库（C#）\64位动态库\MultiCard.dll" Link="MultiCard.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\C#例程源代码及库文件\动态库（C#）\64位动态库\MultiCardCLR.dll" Link="MultiCardCLR.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\C#例程源代码及库文件\动态库（C#）\64位动态库\MultiCardCS.dll" Link="MultiCardCS.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Native\win-x64\msvcr100.dll" Link="msvcr100.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Deploy\启动中央净软线.cmd" Link="启动中央净软线.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Deploy\检查DLL环境.cmd" Link="检查DLL环境.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Deploy\检查DLL环境.ps1" Link="检查DLL环境.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Deploy\部署说明.txt" Link="部署说明.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PipelineControl.Application\PipelineControl.Application.csproj" />
    <ProjectReference Include="..\PipelineControl.Infrastructure\PipelineControl.Infrastructure.csproj" />
  </ItemGroup>

</Project>
